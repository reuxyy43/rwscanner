{
  "name": "rwscanner",
  "version": "1.0.0",
  "description": "RwScanner - FiveM Security Scanner",
  "main": "src/main.js",
  "author": "RW Team",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir",
    "build:packager": "electron-packager . RwScanner --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"dist|node_modules\""
  },
  "build": {
    "appId": "com.rwscanner.app",
    "productName": "RwScanner",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.png"
    },
    "portable": {
      "artifactName": "RwScanner.exe"
    },
    "files": [
      "src/**/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ]
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  }
}
